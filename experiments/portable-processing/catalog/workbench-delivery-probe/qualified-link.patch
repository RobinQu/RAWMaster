+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn hardlink_syncs_changed_or_unqualified_source_and_rename_always_syncs_both() -> Result<()> {
+        let temp = tempfile::tempdir()?;
+        let root = Root::open(temp.path())?;
+        let folder = format!(".rawmaster-export-{}", uuid::Uuid::new_v4());
+        let directory = temp.path().join(&folder);
+        std::fs::create_dir(&directory)?;
+        std::fs::write(directory.join("pixels.jpg"), b"joined image")?;
+        let stage = Stage::read(
+            &root,
+            &format!("{folder}/pixels.jpg"),
+            "final.jpg".into(),
+            "jpg",
+            true,
+        )?;
+        // Publish from a fresh read of the persisted ticket, as a reopened worker would.
+        let prepared = Stage::from_ticket(&root, &stage.ticket, "jpg")?.unwrap();
+        let method = prepared.publish(&root, || Ok(()))?.unwrap();
+        assert!(matches!(method, Publication::Linked));
+        assert_eq!(
+            prepared.source_requires_sync(Publication::Linked),
+            !root.binding.identity.stable()
+        );
+        assert!(prepared.source_requires_sync(Publication::Renamed));
+        prepared.sync_publication(&root, method)?;
+        std::fs::write(directory.join("retained-entry"), b"unrelated stage content")?;
+        assert!(prepared.source_requires_sync(Publication::Linked));
+        assert_eq!(
+            std::fs::read(temp.path().join("final.jpg"))?,
+            b"joined image"
+        );
+        Ok(())
+    }
+}
