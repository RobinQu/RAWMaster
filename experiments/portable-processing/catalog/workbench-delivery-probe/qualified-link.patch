+// This witness is used only on APFS with its persistent volume identity and nanosecond times.
+#[derive(Eq, PartialEq)]
+struct DirectoryStamp {
+    links: u64,
+    modified: (i64, i64),
+    changed: (i64, i64),
+}
+
+impl DirectoryStamp {
+    fn of(metadata: &Metadata) -> Self {
+        Self {
+            links: metadata.nlink(),
+            modified: (metadata.mtime(), metadata.mtime_nsec()),
+            changed: (metadata.ctime(), metadata.ctime_nsec()),
+        }
+    }
+}
