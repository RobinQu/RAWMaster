    "behavior": "libGLX_nvidia Vulkan initialization calls XOpenDisplay(NULL); on a headless host it returns VK_ERROR_INCOMPATIBLE_DRIVER (-3), so the loader ignores the ICD.",
    "containerNote": "NVIDIA_DRIVER_CAPABILITIES=compute,utility does not mount libEGL_nvidia/libGLX_nvidia; graphics must be included.",
    "eglBehavior": "exports the same Vulkan ICD entry points and negotiates successfully headless; vkEnumerateInstanceVersion reports 1.4.341",
    "eglLibrary": "libEGL_nvidia.so.0",
    "evidence": [
      "libGLX_nvidia vk_icdNegotiateLoaderICDInterfaceVersion returns -3 for requests 1..8",
      "libGLX_nvidia vkEnumerateInstanceVersion returns -3",
      "libGLX_nvidia disassembly calls XOpenDisplay(NULL)",
      "installing libegl1 alone does not fix the GLX ICD",
      "Xvfb is not a substitute for NVIDIA GLX"
    ],
    "packagedICD": "/usr/share/vulkan/icd.d/nvidia_icd.json",
    "packagedLibrary": "libGLX_nvidia.so.0",
    "vkscNote": "libnvidia-vksc-core is a Vulkan SC ICD, not the normal Vulkan path; do not use it."
  },
